# Alya-FIIT environment variables — copy to .env and adjust if needed.
# Every value here is a safe local default; there are no real secrets in this
# project and none should ever be added.

# --- Backend -----------------------------------------------------------------

# SQLite database URL. Must be an absolute path (relative paths break when the
# working directory changes). Docker Compose overrides this to /app/data/dev.db.
# ALYA_DATABASE_URL=sqlite:////absolute/path/to/backend/data/dev.db

# JWT signing secret for local development. It only affects tokens issued on
# your own machine.
ALYA_JWT_SECRET=dev-only-secret-not-for-production
ALYA_JWT_EXPIRES_MINUTES=720

# Domain defaults
ALYA_VAT_RATE=0.23
ALYA_DEFAULT_LOW_STOCK_THRESHOLD=5
ALYA_MAX_QUANTITY_PER_LINE=10
ALYA_RETURN_WINDOW_DAYS=14
ALYA_DELIVERY_ESTIMATE_DAYS=2

# Origins allowed to call the API directly (JSON array). Only relevant for the
# manual dev-server path; the Docker path is same-origin through nginx.
ALYA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Frontend (build/dev time) -----------------------------------------------

# Backend origin the Vite dev server proxies /api to.
VITE_API_PROXY_TARGET=http://localhost:8000
